{
  "manifest_version": 3,
  "name": "Web Themes",
  "version": "1.0.0",
  "description": "Restyle sites with the current desktop theme.",
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Web Themes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["match.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "catalog.json",
        "revision",
        "enabled",
        "theme.json",
        "colors.css",
        "sites/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
